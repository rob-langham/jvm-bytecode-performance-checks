<?xml version="1.0" encoding="UTF-8"?>
<!--
  Two classes the static checker cannot tell apart - so this passes, and the
  interesting part is invisible from here.

  Self-contained on purpose: no parent POM, so everything this scenario needs is on this page -
  the annotations dependency, and the checker plugin bound to `verify`. Copy it as it stands.

  Needs `./gradlew publishToMavenLocal` at the repo root first; both artifacts resolve from
  Maven Local.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.rob-langham.demos</groupId>
  <artifactId>07-runtime-flight-recorder</artifactId>
  <version>0.1.0</version>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <!-- The annotations. Nothing else is needed at compile time. -->
      <groupId>io.github.rob-langham</groupId>
      <artifactId>core</artifactId>
      <version>0.1.0</version>
    </dependency>
  </dependencies>

  <!-- The runtime half of this demo - attaching the recorder as a -javaagent and running the
       load driver - is Gradle-only (`./gradlew -p demo :07-runtime-flight-recorder:run`).
       Maven builds the classes and runs the static check, which is expected to be clean. -->

  <build>
    <plugins>
      <plugin>
        <groupId>io.github.rob-langham</groupId>
        <artifactId>maven-plugin</artifactId>
        <version>0.1.0</version>
        <executions>
          <execution>
            <goals><goal>check</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
